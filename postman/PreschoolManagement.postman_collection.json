{
  "info": {
    "name": "Preschool Management API",
    "_postman_id": "4f4f4e87-cc84-4ea2-a181-7cabec7f2944",
    "description": "Quick QA collection for Preschool Management API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "https://localhost:7147" },
    { "key": "accessToken", "value": "" },
    { "key": "refreshToken", "value": "" },
    { "key": "schoolId", "value": "" },
    { "key": "teacherId", "value": "" },
    { "key": "classId", "value": "" },
    { "key": "parentId", "value": "" },
    { "key": "studentId", "value": "" }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login Super Admin",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"superadmin@preschool.local\",\n  \"password\": \"Admin@123\"\n}"
            },
            "url": "{{baseUrl}}/api/auth/login"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "if (json && json.data) {",
                  "  pm.collectionVariables.set('accessToken', json.data.accessToken || '');",
                  "  pm.collectionVariables.set('refreshToken', json.data.refreshToken || '');",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Refresh Token",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}"
            },
            "url": "{{baseUrl}}/api/auth/refresh-token"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', function () { pm.response.to.have.status(200); });",
                  "const json = pm.response.json();",
                  "pm.test('Refresh response has token data', function () { pm.expect(json.success).to.eql(true); pm.expect(json.data).to.be.an('object'); });",
                  "if (json && json.data) {",
                  "  pm.collectionVariables.set('accessToken', json.data.accessToken || '');",
                  "  pm.collectionVariables.set('refreshToken', json.data.refreshToken || '');",
                  "}"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "QA Seed",
      "item": [
        {
          "name": "Seed Quick QA Data",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "url": "{{baseUrl}}/api/test-data/seed-quick-qa"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', function () { pm.response.to.have.status(200); });",
                  "const json = pm.response.json();",
                  "pm.test('Seed call success', function () { pm.expect(json.success).to.eql(true); });",
                  "const entities = json?.data?.entities;",
                  "if (entities) {",
                  "  pm.collectionVariables.set('schoolId', entities.schoolId || '');",
                  "  pm.collectionVariables.set('teacherId', entities.teacherId || '');",
                  "  pm.collectionVariables.set('classId', entities.classId || '');",
                  "  pm.collectionVariables.set('parentId', entities.parentId || '');",
                  "  pm.collectionVariables.set('studentId', entities.studentId || '');",
                  "}",
                  "pm.test('Seed IDs populated', function () {",
                  "  pm.expect(pm.collectionVariables.get('studentId')).to.not.be.empty;",
                  "  pm.expect(pm.collectionVariables.get('classId')).to.not.be.empty;",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Seed Status",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "url": "{{baseUrl}}/api/test-data/status"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', function () { pm.response.to.have.status(200); });",
                  "const json = pm.response.json();",
                  "pm.test('Seed status has counts', function () { pm.expect(json.success).to.eql(true); pm.expect(json.data.users).to.be.a('number'); });"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Students",
      "item": [
        {
          "name": "Get Students",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "url": "{{baseUrl}}/api/students?pageNumber=1&pageSize=10&sortBy=CreatedDate&sortDescending=true"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', function () { pm.response.to.have.status(200); });",
                  "const json = pm.response.json();",
                  "pm.test('Students page returned', function () { pm.expect(json.success).to.eql(true); pm.expect(json.data.items).to.be.an('array'); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Get Student By Id",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "url": "{{baseUrl}}/api/students/{{studentId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', function () { pm.response.to.have.status(200); });",
                  "const json = pm.response.json();",
                  "pm.test('Student loaded by ID', function () { pm.expect(json.success).to.eql(true); pm.expect(json.data.id).to.eql(pm.collectionVariables.get('studentId')); });"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Attendance",
      "item": [
        {
          "name": "Get Attendances",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "url": "{{baseUrl}}/api/attendances?pageNumber=1&pageSize=20"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', function () { pm.response.to.have.status(200); });",
                  "const json = pm.response.json();",
                  "pm.test('Attendance page returned', function () { pm.expect(json.success).to.eql(true); pm.expect(json.data.items).to.be.an('array'); });"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Reports & Dashboard",
      "item": [
        {
          "name": "Dashboard Summary",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "url": "{{baseUrl}}/api/dashboard/summary"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', function () { pm.response.to.have.status(200); });",
                  "const json = pm.response.json();",
                  "pm.test('Dashboard contains totals', function () { pm.expect(json.success).to.eql(true); pm.expect(json.data.totalStudents).to.be.a('number'); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Attendance Report",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fromDate\": \"2026-01-01T00:00:00Z\",\n  \"toDate\": \"2026-12-31T23:59:59Z\",\n  \"classId\": \"{{classId}}\"\n}"
            },
            "url": "{{baseUrl}}/api/reports/attendance"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', function () { pm.response.to.have.status(200); });",
                  "const json = pm.response.json();",
                  "pm.test('Attendance report payload returned', function () { pm.expect(json.success).to.eql(true); pm.expect(json.data).to.be.an('array'); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Fee Collection Report",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fromDate\": \"2026-01-01T00:00:00Z\",\n  \"toDate\": \"2026-12-31T23:59:59Z\"\n}"
            },
            "url": "{{baseUrl}}/api/reports/fee-collection"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', function () { pm.response.to.have.status(200); });",
                  "const json = pm.response.json();",
                  "pm.test('Fee report payload returned', function () { pm.expect(json.success).to.eql(true); pm.expect(json.data).to.be.an('array'); });"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}
